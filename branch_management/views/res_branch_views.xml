<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_branch_list" model="ir.ui.view">
        <field name="name">res.branch.list</field>
        <field name="model">res.branch</field>
        <field name="arch" type="xml">
            <list string="Branches">
                <field name="sequence" widget="handle"/>
                <field name="complete_name" string="Name"/>
                <field name="code"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="parent_id" optional="show"/>
                <field name="manager_id" optional="show" widget="many2one_avatar_user"/>
                <field name="phone" optional="show"/>
                <field name="email" optional="hide"/>
                <field name="city" optional="hide"/>
                <field name="active" optional="show" widget="boolean_toggle" readonly="1"/>
            </list>
        </field>
    </record>

    <record id="view_res_branch_form" model="ir.ui.view">
        <field name="name">res.branch.form</field>
        <field name="model">res.branch</field>
        <field name="arch" type="xml">
            <form string="Branch">
                <header>
                    <button name="%(branch_management.action_branch_user_assign)d" type="action"
                            string="Assign Users" groups="branch_management.group_branch_manager"
                            invisible="not id"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_users" type="object" class="oe_stat_button"
                                icon="group" groups="branch_management.group_branch_manager">
                            <field name="user_count" widget="statinfo" string="Users"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="d-flex flex-column flex-md-row align-items-center gap-3">
                        <field name="logo" widget="image" class="oe_avatar" nolabel="1"
                               options="{'size': [100, 100]}"/>
                        <div class="oe_title w-100">
                            <label for="name"/>
                            <h1><field name="name" placeholder="e.g. Ahmedabad"/></h1>
                            <field name="complete_name" invisible="not parent_id" class="text-muted"/>
                        </div>
                    </div>
                    <notebook>
                        <page string="General Information" name="general">
                            <group>
                                <group name="identity">
                                    <field name="code" placeholder="e.g. AHM"/>
                                    <field name="company_id" groups="base.group_multi_company"
                                           options="{'no_create': True}"/>
                                    <field name="company_id" invisible="1" groups="!base.group_multi_company"/>
                                    <field name="parent_id" options="{'no_create': True}"/>
                                    <field name="manager_id" widget="many2one_avatar_user"/>
                                </group>
                                <group name="contact" string="Contact Information">
                                    <label for="street" string="Address"/>
                                    <div class="o_address_format">
                                        <field name="street" placeholder="Street..." class="o_address_street"/>
                                        <field name="street2" placeholder="Street 2..." class="o_address_street"/>
                                        <field name="city" placeholder="City" class="o_address_city"/>
                                        <field name="state_id" class="o_address_state" placeholder="State"
                                               options="{'no_open': True, 'no_create': True}"/>
                                        <field name="zip" placeholder="ZIP" class="o_address_zip"/>
                                        <field name="country_id" placeholder="Country" class="o_address_country"
                                               options="{'no_open': True, 'no_create': True}"/>
                                    </div>
                                    <field name="phone" widget="phone"/>
                                    <field name="mobile" widget="phone"/>
                                    <field name="email" widget="email"/>
                                    <field name="website" widget="url"/>
                                    <field name="partner_id" options="{'no_create': True}"/>
                                </group>
                            </group>
                        </page>
                        <page string="Users" name="users" groups="branch_management.group_branch_manager">
                            <field name="user_ids" options="{'no_create': True}">
                                <list>
                                    <field name="name"/>
                                    <field name="login"/>
                                    <field name="default_branch_id" optional="show"/>
                                </list>
                            </field>
                        </page>
                        <page string="Sub-branches" name="children" invisible="not child_ids">
                            <field name="child_ids" readonly="1">
                                <list>
                                    <field name="complete_name"/>
                                    <field name="code"/>
                                    <field name="manager_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Configuration" name="configuration">
                            <group>
                                <group name="numbering" string="Numbering">
                                    <field name="sequence_prefix" placeholder="Defaults to the branch code"/>
                                    <field name="sequence"/>
                                </group>
                                <group name="configuration_extra"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_res_branch_search" model="ir.ui.view">
        <field name="name">res.branch.search</field>
        <field name="model">res.branch</field>
        <field name="arch" type="xml">
            <search string="Branches">
                <field name="complete_name" string="Name"/>
                <field name="code"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="manager_id"/>
                <field name="city"/>
                <filter name="my_branches" string="My Branches" domain="[('is_user_allowed', '=', True)]"/>
                <separator/>
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
                <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"
                        groups="base.group_multi_company"/>
                <filter name="group_parent" string="Parent Branch" context="{'group_by': 'parent_id'}"/>
                <filter name="group_manager" string="Manager" context="{'group_by': 'manager_id'}"/>
            </search>
        </field>
    </record>

    <record id="view_res_branch_kanban" model="ir.ui.view">
        <field name="name">res.branch.kanban</field>
        <field name="model">res.branch</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <templates>
                    <t t-name="card" class="flex-row">
                        <aside>
                            <field name="logo" widget="image" options="{'size': [48, 48]}"/>
                        </aside>
                        <main class="ms-2">
                            <field name="complete_name" class="fw-bold"/>
                            <span>[<field name="code"/>]</span>
                            <field name="city" class="text-muted"/>
                            <field name="company_id" groups="base.group_multi_company" class="text-muted"/>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_res_branch" model="ir.actions.act_window">
        <field name="name">Branches</field>
        <field name="res_model">res.branch</field>
        <field name="path">branches</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_res_branch_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first branch</p>
            <p>Branches split one company into units (offices, stores, regions)
               with their own users, documents and numbering.</p>
        </field>
    </record>
</odoo>
