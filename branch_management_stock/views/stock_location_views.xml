<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_location_search_branch" model="ir.ui.view">
        <field name="name">stock.location.search.branch</field>
        <field name="model">stock.location</field>
        <field name="inherit_id" ref="stock.view_location_search"/>
        <field name="arch" type="xml">
            <field name="warehouse_id" position="after">
                <field name="branch_id"/>
            </field>
            <filter name="warehouse" position="after">
                <filter string="Branch" name="group_branch" context="{'group_by': 'branch_id'}"/>
            </filter>
        </field>
    </record>

    <record id="view_location_tree2_branch" model="ir.ui.view">
        <field name="name">stock.location.list.branch</field>
        <field name="model">stock.location</field>
        <field name="inherit_id" ref="stock.view_location_tree2"/>
        <field name="arch" type="xml">
            <field name="usage" position="after">
                <field name="branch_id" optional="show"/>
            </field>
        </field>
    </record>
</odoo>
