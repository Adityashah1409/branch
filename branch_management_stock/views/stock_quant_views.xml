<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="quant_search_view_branch" model="ir.ui.view">
        <field name="name">stock.quant.search.branch</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.quant_search_view"/>
        <field name="arch" type="xml">
            <field name="warehouse_id" position="after">
                <field name="branch_id"/>
            </field>
            <filter name="locationgroup" position="after">
                <filter string="Branch" name="branchgroup" context="{'group_by': 'branch_id'}"/>
            </filter>
        </field>
    </record>

    <record id="view_stock_quant_tree_simple_branch" model="ir.ui.view">
        <field name="name">stock.quant.list.simple.branch</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_simple"/>
        <field name="arch" type="xml">
            <field name="location_id" position="after">
                <field name="branch_id" optional="hide"/>
            </field>
        </field>
    </record>

    <record id="view_stock_quant_tree_inventory_editable_branch" model="ir.ui.view">
        <field name="name">stock.quant.inventory.list.editable.branch</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_inventory_editable"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='location_id']" position="after">
                <field name="branch_id" optional="hide" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
