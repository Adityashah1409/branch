<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_warehouse_form_branch" model="ir.ui.view">
        <field name="name">stock.warehouse.form.branch</field>
        <field name="model">stock.warehouse</field>
        <field name="inherit_id" ref="stock.view_warehouse"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="before">
                <field name="branch_id" options="{'no_create': True}"/>
            </field>
        </field>
    </record>

    <record id="view_warehouse_list_branch" model="ir.ui.view">
        <field name="name">stock.warehouse.list.branch</field>
        <field name="model">stock.warehouse</field>
        <field name="inherit_id" ref="stock.view_warehouse_tree"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="branch_id" optional="show"/>
            </field>
        </field>
    </record>

    <record id="stock_warehouse_view_search_branch" model="ir.ui.view">
        <field name="name">stock.warehouse.search.branch</field>
        <field name="model">stock.warehouse</field>
        <field name="inherit_id" ref="stock.stock_warehouse_view_search"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="branch_id"/>
            </field>
            <filter name="inactive" position="before">
                <filter name="current_branch" string="Current Branch"
                        domain="[('is_current_branch', '=', True)]"/>
                <separator/>
            </filter>
            <filter name="inactive" position="after">
                <filter name="group_branch" string="Branch" context="{'group_by': 'branch_id'}"/>
            </filter>
        </field>
    </record>
</odoo>
