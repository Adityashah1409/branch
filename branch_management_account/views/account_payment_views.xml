<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_form_inherit_branch" model="ir.ui.view">
        <field name="name">account.payment.form.branch</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='group2']/field[@name='journal_id']" position="before">
                <field name="branch_id" readonly="state != 'draft'" options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>

    <record id="view_account_payment_tree_inherit_branch" model="ir.ui.view">
        <field name="name">account.payment.list.branch</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_tree"/>
        <field name="arch" type="xml">
            <field name="journal_id" position="after">
                <field name="branch_id" optional="show"/>
            </field>
        </field>
    </record>

    <record id="view_account_payment_search_inherit_branch" model="ir.ui.view">
        <field name="name">account.payment.search.branch</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_search"/>
        <field name="arch" type="xml">
            <field name="journal_id" position="after">
                <field name="branch_id"/>
            </field>
            <filter name="state_draft" position="before">
                <filter name="current_branch" string="Current Branch" domain="[('is_current_branch', '=', True)]"/>
                <separator/>
            </filter>
            <filter name="journal" position="after">
                <filter string="Branch" name="group_by_branch" context="{'group_by': 'branch_id'}"/>
            </filter>
        </field>
    </record>
</odoo>
