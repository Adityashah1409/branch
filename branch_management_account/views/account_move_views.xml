<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Journal entries / invoices / bills -->
    <record id="view_move_form_inherit_branch" model="ir.ui.view">
        <field name="name">account.move.form.branch</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@id='header_right_group']" position="inside">
                <field name="branch_id" readonly="state != 'draft'" options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>

    <record id="view_invoice_tree_inherit_branch" model="ir.ui.view">
        <field name="name">account.invoice.list.branch</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
            <field name="journal_id" position="after">
                <field name="branch_id" optional="show" readonly="1"/>
            </field>
        </field>
    </record>

    <record id="view_move_tree_inherit_branch" model="ir.ui.view">
        <field name="name">account.move.list.branch</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_tree"/>
        <field name="arch" type="xml">
            <field name="journal_id" position="after">
                <field name="branch_id" optional="show" readonly="1"/>
            </field>
        </field>
    </record>

    <record id="view_account_invoice_filter_inherit_branch" model="ir.ui.view">
        <field name="name">account.invoice.select.branch</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <field name="journal_id" position="after">
                <field name="branch_id"/>
            </field>
            <filter name="draft" position="before">
                <filter name="current_branch" string="Current Branch" domain="[('is_current_branch', '=', True)]"/>
                <separator/>
            </filter>
            <filter name="groupy_by_journal" position="after">
                <filter string="Branch" name="group_by_branch" context="{'group_by': 'branch_id'}"/>
            </filter>
        </field>
    </record>

    <record id="view_account_move_filter_inherit_branch" model="ir.ui.view">
        <field name="name">account.move.select.branch</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_move_filter"/>
        <field name="arch" type="xml">
            <field name="journal_id" position="after">
                <field name="branch_id"/>
            </field>
            <filter name="unposted" position="before">
                <filter name="current_branch" string="Current Branch" domain="[('is_current_branch', '=', True)]"/>
                <separator/>
            </filter>
            <filter name="journal" position="after">
                <filter string="Branch" name="group_by_branch" context="{'group_by': 'branch_id'}"/>
            </filter>
        </field>
    </record>

    <!-- Journal items -->
    <record id="view_move_line_tree_inherit_branch" model="ir.ui.view">
        <field name="name">account.move.line.list.branch</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_tree"/>
        <field name="arch" type="xml">
            <field name="journal_id" position="after">
                <field name="branch_id" optional="hide"/>
            </field>
        </field>
    </record>

    <record id="view_account_move_line_filter_inherit_branch" model="ir.ui.view">
        <field name="name">account.move.line.search.branch</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_account_move_line_filter"/>
        <field name="arch" type="xml">
            <field name="journal_id" position="after">
                <field name="branch_id"/>
            </field>
            <filter name="journal" position="after">
                <filter string="Branch" name="group_by_branch" context="{'group_by': 'branch_id'}"/>
            </filter>
        </field>
    </record>
</odoo>
