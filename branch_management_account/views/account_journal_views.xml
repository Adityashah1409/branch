<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_journal_form_inherit_branch" model="ir.ui.view">
        <field name="name">account.journal.form.branch</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <field name="journal_group_id" position="before">
                <field name="branch_id" options="{'no_create': True}" placeholder="All branches"/>
            </field>
        </field>
    </record>

    <record id="view_account_journal_tree_inherit_branch" model="ir.ui.view">
        <field name="name">account.journal.list.branch</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_tree"/>
        <field name="arch" type="xml">
            <field name="code" position="after">
                <field name="branch_id" optional="show"/>
            </field>
        </field>
    </record>

    <record id="view_account_journal_search_inherit_branch" model="ir.ui.view">
        <field name="name">account.journal.search.branch</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_search"/>
        <field name="arch" type="xml">
            <field name="activity_user_id" position="before">
                <field name="branch_id"/>
            </field>
            <filter name="inactive" position="after">
                <group>
                    <filter string="Branch" name="group_by_branch" context="{'group_by': 'branch_id'}"/>
                </group>
            </filter>
        </field>
    </record>
</odoo>
