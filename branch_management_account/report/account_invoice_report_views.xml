<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_invoice_report_search_inherit_branch" model="ir.ui.view">
        <field name="name">account.invoice.report.search.branch</field>
        <field name="model">account.invoice.report</field>
        <field name="inherit_id" ref="account.view_account_invoice_report_search"/>
        <field name="arch" type="xml">
            <field name="invoice_user_id" position="after">
                <field name="branch_id"/>
            </field>
            <filter name="company" position="after">
                <filter string="Branch" name="group_by_branch" context="{'group_by': 'branch_id'}"/>
            </filter>
        </field>
    </record>
</odoo>
