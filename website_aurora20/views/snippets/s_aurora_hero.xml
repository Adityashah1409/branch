<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="s_aurora_hero" name="Aurora Hero">
        <section class="s_aurora_hero o_cc o_cc5 position-relative overflow-hidden pt80 pb80" data-oe-shape-data="">
            <div class="container">
                <div class="row align-items-center g-5">
                    <div class="col-lg-6">
                        <p class="s_aurora_eyebrow text-uppercase small fw-semibold mb-3">New season collection</p>
                        <h1 class="display-4 fw-bold">Made to be <span class="s_aurora_accent">noticed.</span></h1>
                        <p class="lead mt-3">Fresh arrivals picked for everyday comfort, crafted with care and shipped in days.</p>
                        <div class="d-flex flex-wrap gap-2 mt-4">
                            <a href="/shop" class="btn btn-primary btn-lg">Shop the collection</a>
                            <a href="/brands" class="btn btn-outline-light btn-lg">Explore brands</a>
                        </div>
                        <ul class="s_aurora_hero_points list-unstyled d-flex flex-wrap gap-4 mt-5 mb-0 small">
                            <li><i class="oi me-2" data-icon="local_shipping" role="presentation"/>Fast delivery</li>
                            <li><i class="oi me-2" data-icon="autorenew" role="presentation"/>30-day returns</li>
                            <li><i class="oi me-2" data-icon="verified" role="presentation"/>Secure payment</li>
                        </ul>
                    </div>
                    <div class="col-lg-6">
                        <div class="s_aurora_hero_media position-relative">
                            <img src="/web/image/website.s_carousel_intro_default_image_1" alt="" class="img img-fluid rounded-4 shadow-lg"/>
                            <div class="s_aurora_hero_badge o_cc o_cc1 rounded-3 shadow p-3 position-absolute">
                                <strong class="d-block fs-4 fw-bold text-o-color-1 mb-0">-30%</strong>
                                <span class="small">on selected items</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>
