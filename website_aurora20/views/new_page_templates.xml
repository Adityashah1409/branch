<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        "Aurora Homepages": ten ready-made homepage designs offered in the
        website editor under + New > Page. The page layouts are declared in the
        manifest (``new_page_templates``) and generated by Odoo below.
    -->
    <template id="new_page_template_groups" inherit_id="website.new_page_template_groups" name="Aurora page template group">
        <xpath expr="//div[@id='about_us']" position="before">
            <div id="aurora_home">Aurora Homepages</div>
        </xpath>
    </template>

    <!-- Using `function` so that it runs on both install and update -->
    <function model="ir.module.module" name="_generate_primary_snippet_templates">
        <value eval="[ref('base.module_website_aurora20')]"/>
    </function>
    <function model="ir.module.module" name="_generate_primary_page_templates">
        <value eval="[ref('base.module_website_aurora20')]"/>
    </function>
</odoo>
