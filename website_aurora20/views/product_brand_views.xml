<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="aurora_product_brand_view_list" model="ir.ui.view">
        <field name="name">aurora.product.brand.list</field>
        <field name="model">aurora.product.brand</field>
        <field name="arch" type="xml">
            <list string="Brands">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="website_id" groups="website.group_multi_website" optional="show"/>
                <field name="is_featured" optional="show"/>
                <field name="product_count"/>
                <field name="is_published" string="Published"/>
            </list>
        </field>
    </record>

    <record id="aurora_product_brand_view_form" model="ir.ui.view">
        <field name="name">aurora.product.brand.form</field>
        <field name="model">aurora.product.brand</field>
        <field name="arch" type="xml">
            <form string="Brand">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_products" type="object" class="oe_stat_button" icon="inventory_2">
                            <field name="product_count" widget="statinfo" string="Products"/>
                        </button>
                        <field name="is_published" widget="website_redirect_button"/>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="image_1920" widget="image" class="oe_avatar" options="{'preview_image': 'image_128'}"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Northwind"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="brand_website" widget="url"/>
                            <field name="website_id" options="{'no_create': True}" groups="website.group_multi_website" placeholder="All websites"/>
                            <field name="is_featured"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="banner" widget="image" options="{'size': [240, 120]}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description" placeholder="Tell your visitors about this brand..."/>
                        </page>
                        <page string="SEO" name="seo">
                            <group>
                                <field name="website_meta_title"/>
                                <field name="website_meta_description"/>
                                <field name="website_meta_keywords"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="aurora_product_brand_view_search" model="ir.ui.view">
        <field name="name">aurora.product.brand.search</field>
        <field name="model">aurora.product.brand</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter string="Published" name="published" domain="[('is_published', '=', True)]"/>
                <filter string="Featured" name="featured" domain="[('is_featured', '=', True)]"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="aurora_product_brand_action" model="ir.actions.act_window">
        <field name="name">Brands</field>
        <field name="res_model">aurora.product.brand</field>
        <field name="path">ecommerce-brands</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a brand</p>
            <p>Brands get their own page on your website and can be used to filter the shop.</p>
        </field>
    </record>
</odoo>
