<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Side drawer, filled by the cart drawer interaction. -->
    <template id="cart_drawer" name="Cart Drawer">
        <div id="o_aurora_cart_drawer" class="offcanvas offcanvas-end o_aurora_cart_drawer o_not_editable" tabindex="-1"
             aria-labelledby="o_aurora_cart_drawer_title">
            <div class="offcanvas-header border-bottom">
                <h2 id="o_aurora_cart_drawer_title" class="offcanvas-title h5 mb-0">Your cart</h2>
                <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"/>
            </div>
            <div class="offcanvas-body d-flex flex-column p-0 o_aurora_cart_drawer_body" aria-live="polite">
                <div class="d-flex justify-content-center py-5">
                    <span class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </span>
                </div>
            </div>
        </div>
    </template>

    <template id="cart_drawer_content" name="Cart Drawer Content">
        <t t-set="lines" t-value="website_sale_order and website_sale_order.website_order_line.filtered(lambda l: not l.combo_item_id)"/>
        <t t-if="not lines">
            <div class="o_aurora_cart_empty text-center px-4 py-5 my-auto">
                <i class="oi display-5 text-muted" data-icon="shopping_bag" role="presentation"/>
                <p class="mt-3 mb-4">Your cart is empty.</p>
                <a href="/shop" class="btn btn-primary">Start shopping</a>
            </div>
        </t>
        <t t-else="">
            <ul class="list-unstyled mb-0 flex-grow-1 overflow-auto px-3">
                <li t-foreach="lines" t-as="line" class="o_aurora_cart_line d-flex gap-3 py-3 border-bottom"
                    t-att-data-line-id="line.id" t-att-data-product-id="line.product_id.id">
                    <img t-att-src="website.image_url(line.product_id, 'image_128')" t-att-alt="line.name_short"
                         class="o_aurora_cart_line_img rounded object-fit-cover flex-shrink-0" width="64" height="64" loading="lazy"/>
                    <div class="flex-grow-1 min-w-0">
                        <a t-att-href="line.product_id.website_url" class="d-block fw-semibold text-reset text-truncate"
                           t-out="line._get_line_header()"/>
                        <small t-set="combination_name" t-value="line._get_combination_name()"/>
                        <small t-if="combination_name" class="d-block text-muted" t-out="combination_name"/>
                        <div class="d-flex align-items-center justify-content-between gap-2 mt-2">
                            <div t-if="line._is_product_line() and not line.product_type == 'combo' or line.product_type == 'combo'"
                                 class="input-group input-group-sm w-auto">
                                <button type="button" class="btn btn-light o_aurora_cart_qty" data-delta="-1" aria-label="Remove one">
                                    <i class="oi" data-icon="remove" role="presentation"/>
                                </button>
                                <input type="number" class="form-control text-center o_aurora_cart_qty_input" min="0" step="1"
                                       inputmode="numeric" t-att-value="line._get_displayed_quantity()" aria-label="Quantity"/>
                                <button type="button" class="btn btn-light o_aurora_cart_qty" data-delta="1" aria-label="Add one">
                                    <i class="oi" data-icon="add" role="presentation"/>
                                </button>
                            </div>
                            <span class="fw-semibold text-nowrap"
                                  t-out="line._get_displayed_unit_price() * line.product_uom_qty"
                                  t-options="{'widget': 'monetary', 'display_currency': website_sale_order.currency_id}"/>
                        </div>
                    </div>
                    <button type="button" class="btn btn-link text-muted p-0 align-self-start o_aurora_cart_remove"
                            t-att-aria-label="'Remove %s' % line.name_short" title="Remove">
                        <i class="oi" data-icon="delete" role="presentation"/>
                    </button>
                </li>
            </ul>
            <div class="o_aurora_cart_footer border-top p-3">
                <div class="d-flex justify-content-between fw-semibold mb-1">
                    <span>Subtotal</span>
                    <span t-out="website_sale_order.amount_untaxed if website.tax_display == 'tax_excluded' else website_sale_order.amount_total"
                          t-options="{'widget': 'monetary', 'display_currency': website_sale_order.currency_id}"/>
                </div>
                <p class="small text-muted mb-3">Taxes, delivery and promotions are calculated at checkout.</p>
                <div class="d-grid gap-2">
                    <a href="/shop/checkout?try_skip_step=true" class="btn btn-primary">Checkout</a>
                    <a href="/shop/cart" class="btn btn-outline-primary">View cart and apply a promo code</a>
                </div>
            </div>
        </t>
    </template>
</odoo>
