<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="brands_page" name="Brands">
        <t t-call="website.layout">
            <t t-set="additional_title">Brands</t>
            <div id="wrap" class="o_aurora_brands_page">
                <div class="oe_structure oe_empty" id="oe_structure_aurora_brands_top"/>
                <section class="container py-5">
                    <div class="d-flex flex-column flex-md-row align-items-md-end justify-content-between gap-3 mb-4">
                        <div>
                            <h1 class="mb-1">Brands</h1>
                            <p class="text-muted mb-0">Discover the labels we carry.</p>
                        </div>
                        <form action="/brands" method="get" role="search" class="o_aurora_brand_search">
                            <div class="input-group">
                                <label for="o_aurora_brand_search_input" class="visually-hidden">Search a brand</label>
                                <input id="o_aurora_brand_search_input" type="search" name="search" class="form-control"
                                       t-att-value="search" placeholder="Search a brand..."/>
                                <button type="submit" class="btn btn-primary" aria-label="Search">
                                    <i class="oi" data-icon="search" role="presentation"/>
                                </button>
                            </div>
                        </form>
                    </div>
                    <p t-if="not brands" class="alert alert-info">
                        <t t-if="search">No brand matches your search.</t>
                        <t t-else="">No brand is published yet.</t>
                    </p>
                    <ul t-else="" class="o_aurora_brand_grid list-unstyled row row-cols-2 row-cols-sm-3 row-cols-lg-5 g-3">
                        <li t-foreach="brands" t-as="brand" class="col">
                            <t t-call="website_aurora20.brand_card"/>
                        </li>
                    </ul>
                </section>
                <div class="oe_structure oe_empty" id="oe_structure_aurora_brands_bottom"/>
            </div>
        </t>
    </template>

    <template id="brand_card" name="Brand Card">
        <a t-att-href="brand.website_url"
           class="o_aurora_brand_card card h-100 text-reset text-decoration-none text-center">
            <div class="card-body d-flex flex-column align-items-center justify-content-center gap-2">
                <div class="o_aurora_brand_logo d-flex align-items-center justify-content-center">
                    <img t-if="brand.image_128" t-att-src="website.image_url(brand, 'image_256')"
                         t-att-alt="brand.name" class="img-fluid" loading="lazy"/>
                    <span t-else="" class="o_aurora_brand_initial" aria-hidden="true" t-out="brand.name[:1]"/>
                </div>
                <span class="fw-semibold" t-out="brand.name"/>
                <span t-if="brand.is_featured" class="badge text-bg-primary">Featured</span>
            </div>
        </a>
    </template>

    <template id="brand_page" name="Brand">
        <t t-call="website.layout">
            <t t-set="additional_title" t-value="brand.name"/>
            <div id="wrap" class="o_aurora_brand_page">
                <section t-attf-class="o_aurora_brand_hero position-relative #{'o_aurora_brand_hero_has_banner' if brand.banner else 'o_cc o_cc2'}">
                    <t t-if="brand.banner">
                        <img t-att-src="website.image_url(brand, 'banner')" alt="" class="o_aurora_brand_banner w-100 object-fit-cover"/>
                    </t>
                    <div class="container py-5">
                        <nav aria-label="breadcrumb">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item"><a href="/brands">Brands</a></li>
                                <li class="breadcrumb-item active" aria-current="page" t-out="brand.name"/>
                            </ol>
                        </nav>
                        <div class="d-flex flex-column flex-md-row align-items-md-center gap-4">
                            <img t-if="brand.image_128" t-att-src="website.image_url(brand, 'image_256')"
                                 t-att-alt="brand.name" class="o_aurora_brand_page_logo rounded bg-white p-2"/>
                            <div>
                                <h1 class="mb-2" t-field="brand.name"/>
                                <p class="mb-0 text-muted">
                                    <t t-out="product_count"/> products
                                    <t t-if="brand.brand_website">
                                        ·
                                        <a t-att-href="brand.brand_website" target="_blank" rel="noopener noreferrer">Official website</a>
                                    </t>
                                </p>
                            </div>
                        </div>
                    </div>
                </section>
                <section t-if="not is_html_empty(brand.description)" class="container pt-4">
                    <div class="o_aurora_brand_description" t-field="brand.description"/>
                </section>
                <section class="container py-5">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <h2 class="h4 mb-0">Products</h2>
                        <a t-if="product_count" t-attf-href="/shop?brand=#{brand.id}" class="btn btn-outline-primary btn-sm">
                            Filter the shop by <t t-out="brand.name"/>
                        </a>
                    </div>
                    <p t-if="not products" class="text-muted">No product of this brand is available yet.</p>
                    <div t-else="" class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-4">
                        <div t-foreach="products" t-as="product" class="col">
                            <t t-call="website_aurora20.product_card_light"/>
                        </div>
                    </div>
                </section>
                <div class="oe_structure oe_empty" id="oe_structure_aurora_brand_bottom"/>
            </div>
        </t>
    </template>

    <!-- Light product card used where the full shop tile context is not available. -->
    <template id="product_card_light" name="Product Card (light)">
        <article class="o_aurora_product_card card h-100 border-0">
            <a t-att-href="product.website_url" class="o_aurora_product_card_media ratio ratio-1x1 rounded overflow-hidden bg-light d-block">
                <img t-att-src="website.image_url(product, 'image_512')" t-att-alt="product.name"
                     class="object-fit-contain w-100 h-100" loading="lazy"/>
            </a>
            <div class="card-body px-0">
                <h3 class="h6 mb-1">
                    <a t-att-href="product.website_url" class="text-reset text-decoration-none" t-out="product.name"/>
                </h3>
                <t t-if="website.aurora_hide_prices()">
                    <a t-attf-href="/web/login?redirect=#{product.website_url}" class="small">Sign in to see the price</a>
                </t>
                <t t-else="">
                    <t t-set="price_vals" t-value="prices.get(product.id, {})"/>
                    <span t-if="'price_reduce' in price_vals" class="fw-semibold" t-out="price_vals['price_reduce']"
                          t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
                    <del t-if="price_vals.get('base_price')" class="text-muted small ms-1" t-out="price_vals['base_price']"
                         t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
                </t>
            </div>
        </article>
    </template>

    <!-- Brand logos building block content (rendered by /aurora/brands/snippet). -->
    <template id="brand_logos" name="Brand Logos">
        <ul t-if="brands" class="o_aurora_brand_logos list-unstyled d-flex flex-wrap justify-content-center align-items-center gap-4 mb-0">
            <li t-foreach="brands" t-as="brand">
                <a t-att-href="brand.website_url" class="o_aurora_brand_logo_link d-flex align-items-center justify-content-center"
                   t-att-title="brand.name">
                    <img t-if="brand.image_128" t-att-src="website.image_url(brand, 'image_256')"
                         t-att-alt="brand.name" loading="lazy"/>
                    <span t-else="" class="fw-semibold" t-out="brand.name"/>
                </a>
            </li>
        </ul>
    </template>
</odoo>
