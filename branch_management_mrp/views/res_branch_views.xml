<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_branch_form_mrp" model="ir.ui.view">
        <field name="name">res.branch.form.mrp</field>
        <field name="model">res.branch</field>
        <field name="inherit_id" ref="branch_management.view_res_branch_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_productions" type="object" class="oe_stat_button"
                        icon="factory" groups="mrp.group_mrp_user" invisible="not id">
                    <field name="production_count" widget="statinfo" string="Manufacturing Orders"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
