<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_production_form_view_branch" model="ir.ui.view">
        <field name="name">mrp.production.form.branch</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='miscellaneous']//field[@name='origin']" position="before">
                <field name="branch_id" options="{'no_create': True}"
                       readonly="state not in ('draft', 'confirmed')" force_save="1"/>
            </xpath>
        </field>
    </record>

    <record id="mrp_production_tree_view_branch" model="ir.ui.view">
        <field name="name">mrp.production.list.branch</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_tree_view"/>
        <field name="arch" type="xml">
            <field name="origin" position="after">
                <field name="branch_id" optional="show" readonly="1"/>
            </field>
        </field>
    </record>

    <record id="view_mrp_production_filter_branch" model="ir.ui.view">
        <field name="name">mrp.production.search.branch</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.view_mrp_production_filter"/>
        <field name="arch" type="xml">
            <field name="picking_type_id" position="after">
                <field name="branch_id"/>
            </field>
            <filter name="starred" position="before">
                <filter name="current_branch" string="Current Branch"
                        domain="[('is_current_branch', '=', True)]"/>
                <separator/>
            </filter>
            <filter name="status" position="after">
                <filter string="Branch" name="group_branch" context="{'group_by': 'branch_id'}"/>
            </filter>
        </field>
    </record>
</odoo>
