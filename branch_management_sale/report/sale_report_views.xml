<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_product_search_inherit_branch" model="ir.ui.view">
        <field name="name">sale.report.search.branch</field>
        <field name="model">sale.report</field>
        <field name="inherit_id" ref="sale.view_order_product_search"/>
        <field name="arch" type="xml">
            <field name="team_id" position="after">
                <field name="branch_id"/>
            </field>
            <filter name="sales_channel" position="after">
                <filter string="Branch" name="group_by_branch" context="{'group_by': 'branch_id'}"/>
            </filter>
        </field>
    </record>
</odoo>
