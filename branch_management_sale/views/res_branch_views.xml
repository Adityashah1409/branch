<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_branch_form_inherit_sale" model="ir.ui.view">
        <field name="name">res.branch.form.sale</field>
        <field name="model">res.branch</field>
        <field name="inherit_id" ref="branch_management.view_res_branch_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_sale_orders" type="object" class="oe_stat_button" icon="sell"
                        groups="sales_team.group_sale_salesman" invisible="not id">
                    <field name="sale_order_count" widget="statinfo" string="Sales"/>
                </button>
            </div>
        </field>
    </record>
</odoo>
