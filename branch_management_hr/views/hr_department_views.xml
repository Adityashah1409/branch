<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_department_form_branch" model="ir.ui.view">
        <field name="name">hr.department.form.branch</field>
        <field name="model">hr.department</field>
        <field name="inherit_id" ref="hr.view_department_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='parent_id']" position="after">
                <field name="branch_id" options="{'no_create': True}" placeholder="All branches"/>
            </xpath>
        </field>
    </record>

    <record id="view_department_tree_branch" model="ir.ui.view">
        <field name="name">hr.department.list.branch</field>
        <field name="model">hr.department</field>
        <field name="inherit_id" ref="hr.view_department_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='manager_id']" position="after">
                <field name="branch_id" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="view_department_filter_branch" model="ir.ui.view">
        <field name="name">hr.department.search.branch</field>
        <field name="model">hr.department</field>
        <field name="inherit_id" ref="hr.view_department_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='manager_id']" position="after">
                <field name="branch_id"/>
            </xpath>
            <xpath expr="//filter[@name='inactive']" position="after">
                <filter name="group_branch" string="Branch" domain="[]" context="{'group_by': 'branch_id'}"/>
            </xpath>
        </field>
    </record>
</odoo>
