<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_branch_form_hr" model="ir.ui.view">
        <field name="name">res.branch.form.hr</field>
        <field name="model">res.branch</field>
        <field name="inherit_id" ref="branch_management.view_res_branch_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_employees" type="object" class="oe_stat_button"
                        icon="badge" groups="hr.group_hr_user">
                    <field name="employee_count" widget="statinfo" string="Employees"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
