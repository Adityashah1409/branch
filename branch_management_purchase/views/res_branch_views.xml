<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_branch_form_inherit_purchase" model="ir.ui.view">
        <field name="name">res.branch.form.purchase</field>
        <field name="model">res.branch</field>
        <field name="inherit_id" ref="branch_management.view_res_branch_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_purchase_orders" type="object" class="oe_stat_button" icon="shopping_cart"
                        groups="purchase.group_purchase_user" invisible="not id">
                    <field name="purchase_order_count" widget="statinfo" string="Purchases"/>
                </button>
            </div>
        </field>
    </record>
</odoo>
