<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_inherit_branch" model="ir.ui.view">
        <field name="name">purchase.order.form.branch</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group/group/field[@name='partner_ref']" position="after">
                <field name="branch_id" readonly="state in ['cancel', 'purchase']" options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>

    <record id="purchase_order_tree_inherit_branch" model="ir.ui.view">
        <field name="name">purchase.order.list.branch</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_tree"/>
        <field name="arch" type="xml">
            <field name="user_id" position="before">
                <field name="branch_id" optional="show" readonly="1"/>
            </field>
        </field>
    </record>

    <record id="purchase_order_kpis_tree_inherit_branch" model="ir.ui.view">
        <field name="name">purchase.order.kpis.list.branch</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_kpis_tree"/>
        <field name="arch" type="xml">
            <field name="user_id" position="before">
                <field name="branch_id" optional="show" readonly="1"/>
            </field>
        </field>
    </record>

    <record id="purchase_order_view_tree_inherit_branch" model="ir.ui.view">
        <field name="name">purchase.order.view.list.branch</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_view_tree"/>
        <field name="arch" type="xml">
            <field name="user_id" position="before">
                <field name="branch_id" optional="show" readonly="1"/>
            </field>
        </field>
    </record>

    <record id="view_purchase_order_filter_inherit_branch" model="ir.ui.view">
        <field name="name">request.quotation.select.branch</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.view_purchase_order_filter"/>
        <field name="arch" type="xml">
            <field name="user_id" position="after">
                <field name="branch_id"/>
            </field>
            <filter name="my_purchases" position="before">
                <filter name="current_branch" string="Current Branch" domain="[('is_current_branch', '=', True)]"/>
                <separator/>
            </filter>
            <filter name="representative" position="after">
                <filter name="group_by_branch" string="Branch" context="{'group_by': 'branch_id'}"/>
            </filter>
        </field>
    </record>

    <record id="purchase_order_view_search_inherit_branch" model="ir.ui.view">
        <field name="name">purchase.order.select.branch</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_view_search"/>
        <field name="arch" type="xml">
            <field name="user_id" position="after">
                <field name="branch_id"/>
            </field>
            <filter name="my_Orders" position="before">
                <filter name="current_branch" string="Current Branch" domain="[('is_current_branch', '=', True)]"/>
                <separator/>
            </filter>
            <filter name="representative" position="after">
                <filter name="group_by_branch" string="Branch" context="{'group_by': 'branch_id'}"/>
            </filter>
        </field>
    </record>

    <record id="purchase_order_line_tree_inherit_branch" model="ir.ui.view">
        <field name="name">purchase.order.line.list.branch</field>
        <field name="model">purchase.order.line</field>
        <field name="inherit_id" ref="purchase.purchase_order_line_tree"/>
        <field name="arch" type="xml">
            <field name="order_id" position="after">
                <field name="branch_id" optional="hide"/>
            </field>
        </field>
    </record>

    <record id="purchase_order_line_search_inherit_branch" model="ir.ui.view">
        <field name="name">purchase.order.line.search.branch</field>
        <field name="model">purchase.order.line</field>
        <field name="inherit_id" ref="purchase.purchase_order_line_search"/>
        <field name="arch" type="xml">
            <field name="order_id" position="after">
                <field name="branch_id"/>
            </field>
            <filter name="order_reference" position="after">
                <filter name="group_by_branch" string="Branch" context="{'group_by': 'branch_id'}"/>
            </filter>
        </field>
    </record>
</odoo>
