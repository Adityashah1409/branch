<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- RFQ and purchase order PDFs: branch block above the order information.
         Odoo 20 t-call: the callee only receives the values passed as attributes. -->
    <template id="report_purchaseorder_document_branch" inherit_id="purchase.report_purchaseorder_document">
        <xpath expr="//div[@id='informations']" position="before">
            <t t-call="branch_management.branch_address_block" branch="o.branch_id"/>
        </xpath>
    </template>

    <template id="report_purchasequotation_document_branch" inherit_id="purchase.report_purchasequotation_document">
        <xpath expr="//div[@id='informations']" position="before">
            <t t-call="branch_management.branch_address_block" branch="o.branch_id"/>
        </xpath>
    </template>
</odoo>
