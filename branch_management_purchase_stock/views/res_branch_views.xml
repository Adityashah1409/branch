<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_branch_form_purchase_stock" model="ir.ui.view">
        <field name="name">res.branch.form.purchase.stock</field>
        <field name="model">res.branch</field>
        <field name="inherit_id" ref="branch_management.view_res_branch_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_purchase_receipts" type="object" class="oe_stat_button"
                        icon="download" groups="stock.group_stock_user" invisible="not id">
                    <field name="purchase_receipt_count" widget="statinfo" string="Receipts"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
