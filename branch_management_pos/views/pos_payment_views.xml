<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_payment_tree_branch" model="ir.ui.view">
        <field name="name">pos.payment.list.branch</field>
        <field name="model">pos.payment</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_payment_tree"/>
        <field name="arch" type="xml">
            <field name="pos_order_id" position="after">
                <field name="branch_id" optional="show"/>
            </field>
        </field>
    </record>

    <record id="view_pos_payment_search_branch" model="ir.ui.view">
        <field name="name">pos.payment.search.branch</field>
        <field name="model">pos.payment</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_payment_search"/>
        <field name="arch" type="xml">
            <field name="pos_order_id" position="after">
                <field name="branch_id"/>
            </field>
            <filter name="group_by_session" position="after">
                <filter name="group_by_branch" string="Branch" context="{'group_by': 'branch_id'}"/>
            </filter>
        </field>
    </record>
</odoo>
