<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_pos_branch" model="ir.ui.view">
        <field name="name">res.config.settings.form.pos.branch</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='is_restaurant']" position="before">
                <setting id="pos_branch" string="Branch"
                         help="Branch operating this shop: its orders, invoices and closing entries belong to it.">
                    <field name="pos_branch_id" readonly="pos_has_active_session"
                           domain="[('company_id', '=', company_id)]" options="{'no_create': True}"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
