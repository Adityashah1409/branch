<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_pos_form_branch" model="ir.ui.view">
        <field name="name">pos.order.form.branch</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='order_operational_details']/field[@name='session_id']" position="after">
                <field name="branch_id" invisible="not branch_id"/>
            </xpath>
        </field>
    </record>

    <record id="view_pos_order_tree_branch" model="ir.ui.view">
        <field name="name">pos.order.list.branch</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_order_tree"/>
        <field name="arch" type="xml">
            <field name="config_id" position="after">
                <field name="branch_id" optional="show"/>
            </field>
        </field>
    </record>

    <record id="view_pos_order_filter_branch" model="ir.ui.view">
        <field name="name">pos.order.list.select.branch</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_order_filter"/>
        <field name="arch" type="xml">
            <field name="config_id" position="after">
                <field name="branch_id"/>
            </field>
            <filter name="cancelled" position="after">
                <separator/>
                <filter string="Current Branch" name="current_branch" domain="[('is_current_branch', '=', True)]"/>
            </filter>
            <filter name="config_id" position="after">
                <filter string="Branch" name="group_by_branch" context="{'group_by': 'branch_id'}"/>
            </filter>
        </field>
    </record>
</odoo>
