<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_branch_form_pos" model="ir.ui.view">
        <field name="name">res.branch.form.pos</field>
        <field name="model">res.branch</field>
        <field name="inherit_id" ref="branch_management.view_res_branch_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_pos_orders" type="object" class="oe_stat_button"
                        icon="storefront" groups="point_of_sale.group_pos_user" invisible="not id">
                    <field name="pos_order_count" widget="statinfo" string="Point of Sale Orders"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
