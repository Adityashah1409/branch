<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_branch_form_project" model="ir.ui.view">
        <field name="name">res.branch.form.project</field>
        <field name="model">res.branch</field>
        <field name="inherit_id" ref="branch_management.view_res_branch_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_projects" type="object" class="oe_stat_button"
                        icon="folder" groups="project.group_project_user">
                    <field name="project_count" widget="statinfo" string="Projects"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
