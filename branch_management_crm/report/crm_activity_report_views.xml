<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_activity_report_view_search_branch" model="ir.ui.view">
        <field name="name">crm.activity.report.search.branch</field>
        <field name="model">crm.activity.report</field>
        <field name="inherit_id" ref="crm.crm_activity_report_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='team_id']" position="after">
                <field name="branch_id"/>
            </xpath>
            <xpath expr="//filter[@name='saleschannel']" position="after">
                <filter string="Branch" name="group_by_branch" context="{'group_by': 'branch_id'}"/>
            </xpath>
        </field>
    </record>
</odoo>
