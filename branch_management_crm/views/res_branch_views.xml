<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_branch_form_crm" model="ir.ui.view">
        <field name="name">res.branch.form.crm</field>
        <field name="model">res.branch</field>
        <field name="inherit_id" ref="branch_management.view_res_branch_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_crm_leads" type="object" class="oe_stat_button"
                        icon="handshake" groups="sales_team.group_sale_salesman">
                    <field name="crm_lead_count" widget="statinfo" string="Leads/Opportunities"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
