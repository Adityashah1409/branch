<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_team_view_form_branch" model="ir.ui.view">
        <field name="name">crm.team.form.branch</field>
        <field name="model">crm.team</field>
        <field name="inherit_id" ref="sales_team.crm_team_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='left']/field[@name='company_id']" position="after">
                <field name="branch_id" options="{'no_create': True}" placeholder="All branches"/>
            </xpath>
        </field>
    </record>

    <record id="crm_team_view_tree_branch" model="ir.ui.view">
        <field name="name">crm.team.list.branch</field>
        <field name="model">crm.team</field>
        <field name="inherit_id" ref="sales_team.crm_team_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_id']" position="after">
                <field name="branch_id" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="crm_team_view_search_branch" model="ir.ui.view">
        <field name="name">crm.team.search.branch</field>
        <field name="model">crm.team</field>
        <field name="inherit_id" ref="sales_team.crm_team_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="branch_id"/>
            </xpath>
            <xpath expr="//filter[@name='company']" position="after">
                <filter string="Branch" name="group_by_branch" context="{'group_by': 'branch_id'}"/>
            </xpath>
        </field>
    </record>
</odoo>
